---
/**
 * HeroMotif — small, restrained line-art SVG above a blog post.
 *
 * Each motif is a single-stroke drawing using `currentColor` so the surrounding
 * `.hero-motif` container controls the actual color (default: --accent-2).
 *
 * To add a new motif: append a new case below with a `viewBox` ~ 240×60 and
 * any number of <path>/<rect>/<circle> elements. Keep stroke-width = 1.4
 * to match the rest of the site's line art.
 */
interface Props {
	name: 'intro' | 'recursion' | 'stack';
	label?: string;
}

const { name, label } = Astro.props;
---

<figure
	class="hero-motif"
	role={label ? 'img' : 'presentation'}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
>
	{name === 'intro' && (
		<svg
			viewBox="0 0 240 110"
			xmlns="http://www.w3.org/2000/svg"
			stroke-width="1.4"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			{/* a quill / fountain-pen nib + an ink drop forming below it.
			    Kite silhouette pointing down, slit + vent hole inside,
			    and a cubic-bezier teardrop hanging below the tip. */}
			{/* nib outline — flat top, shoulders, tip */}
			<path d="M 108 18 L 132 18 L 136 36 L 120 72 L 104 36 Z" />
			{/* slit, stops inside the tip */}
			<path d="M 120 24 L 120 60" />
			{/* vent hole at the top of the slit */}
			<circle cx="120" cy="28" r="1.8" />
			{/* ink drop hanging below the nib tip */}
			<path d="M 120 80 C 110 85, 110 100, 120 100 C 130 100, 130 85, 120 80 Z" />
			{/* faint page-line beneath, hinting at "writing on paper" */}
			<path d="M 30 106 L 210 106" opacity="0.35" />
		</svg>
	)}

	{name === 'recursion' && (
		<svg
			viewBox="0 0 240 110"
			xmlns="http://www.w3.org/2000/svg"
			stroke-width="1.4"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			{/* a binary recursion tree: 1 root → 2 children → 4 grandchildren.
			    The canonical schematic of a recursive call expanding. */}
			{/* edges */}
			<path d="M 120 22 L 76 50" />
			<path d="M 120 22 L 164 50" />
			<path d="M 72 58 L 44 86" />
			<path d="M 72 58 L 100 86" />
			<path d="M 168 58 L 140 86" />
			<path d="M 168 58 L 196 86" />
			{/* nodes (hollow circles) */}
			<circle cx="120" cy="18" r="4" />
			<circle cx="72" cy="54" r="4" />
			<circle cx="168" cy="54" r="4" />
			<circle cx="40" cy="90" r="4" />
			<circle cx="104" cy="90" r="4" />
			<circle cx="136" cy="90" r="4" />
			<circle cx="200" cy="90" r="4" />
		</svg>
	)}

	{name === 'stack' && (
		<svg
			viewBox="0 0 240 80"
			xmlns="http://www.w3.org/2000/svg"
			stroke-width="1.4"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			{/* three stacked horizontal slabs of decreasing width —
			    "decomposition / chunking" */}
			<rect x="40" y="18" width="160" height="10" rx="2" />
			<rect x="60" y="34" width="120" height="10" rx="2" />
			<rect x="80" y="50" width="80" height="10" rx="2" />
		</svg>
	)}
</figure>
