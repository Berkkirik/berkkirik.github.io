---
import '../styles/global.css';
import { SITE, NAV, SOCIALS } from '../config';

interface Props {
	title?: string;
	description?: string;
	/** Sub-nav category label, shown in the frosted strip under the global nav. */
	subNavCategory?: string;
	/** Optional sub-nav primary CTA shown right-aligned in the frosted strip. */
	subNavCta?: { label: string; href: string };
}

const {
	title,
	description = SITE.description,
	subNavCategory,
	subNavCta,
} = Astro.props;

const fullTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isCurrent(href: string): boolean {
	const normalized = href.replace(/\/$/, '') || '/';
	if (normalized === '/') return currentPath === '/';
	return currentPath === normalized || currentPath.startsWith(normalized + '/');
}

const navUtility = SOCIALS.filter(
	(s) => s.label === 'github' || s.label === 'linkedin' || s.label === 'email',
);
const footerSocial = SOCIALS.filter((s) => s.label !== 'rss');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title={`${SITE.title} — Blog`} href="/rss.xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={SITE.author} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={SITE.title} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />

		<meta name="theme-color" content="#000000" />
	</head>
	<body>
		<a class="sr-only" href="#main">Skip to content</a>

		<header class="global-nav" role="banner">
			<div class="global-nav-inner">
				<a class="brand-mark" href="/" aria-label={`${SITE.author} — home`}>BK</a>

				<nav class="global-nav-links" aria-label="Primary">
					{NAV.map((item) => (
						<a
							href={item.href}
							aria-current={isCurrent(item.href) ? 'page' : undefined}
						>{item.label}</a>
					))}
				</nav>

				<div class="global-nav-utility" aria-label="Contact">
					{navUtility.map((s) => (
						<a
							href={s.href}
							target={s.external ? '_blank' : undefined}
							rel={s.external ? 'me noopener' : undefined}
						>{s.label}</a>
					))}
				</div>
			</div>
		</header>

		{subNavCategory && (
			<div class="sub-nav" role="navigation" aria-label="Section">
				<div class="sub-nav-inner">
					<span class="sub-nav-category">{subNavCategory}</span>
					<div class="sub-nav-links">
						{subNavCta && (
							<a
								class="btn btn-primary"
								href={subNavCta.href}
								target={subNavCta.href.startsWith('http') || subNavCta.href.startsWith('mailto:') ? '_blank' : undefined}
								rel={subNavCta.href.startsWith('http') ? 'noopener' : undefined}
							>{subNavCta.label}</a>
						)}
					</div>
				</div>
			</div>
		)}

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer" role="contentinfo">
			<div class="site-footer-inner">
				<div class="site-footer-grid">
					<div class="site-footer-col">
						<h4>Pages</h4>
						<ul>
							{NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
						</ul>
					</div>
					<div class="site-footer-col">
						<h4>Around the web</h4>
						<ul>
							{footerSocial.map((s) => (
								<li>
									<a
										href={s.href}
										target={s.external ? '_blank' : undefined}
										rel={s.external ? 'me noopener' : undefined}
									>{s.label}</a>
								</li>
							))}
							<li><a href="/rss.xml">rss</a></li>
						</ul>
					</div>
					<div class="site-footer-col">
						<h4>Resume</h4>
						<ul>
							<li><a href="/resume/">on this site</a></li>
							<li><a href={SITE.resumePath} target="_blank" rel="noopener">PDF</a></li>
							<li><a href="https://orcid.org/0009-0004-5045-3048" target="_blank" rel="me noopener">ORCID</a></li>
						</ul>
					</div>
				</div>

				<div class="site-footer-legal">
					<span>&copy; {new Date().getFullYear()} {SITE.author}</span>
					<span>Ankara, Türkiye</span>
					<span>Built with Astro · hosted on GitHub Pages</span>
				</div>
			</div>
		</footer>
	</body>
</html>
