---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.filter((p) => import.meta.env.PROD ? !p.data.draft : true)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout
	title="blog"
	description="Writing by Berk Kırık on production AI, LLMs, agents, and the unglamorous infra around them."
>
	<div class="shell">
		<section class="page-hero">
			<p class="eyebrow">/notes</p>
			<h1>Notes.</h1>
			<p class="lead">
				Short essays from production: LLMs, RAG, agents, and the unglamorous
				infra around them. Subscribe via <a href="/rss.xml">RSS</a>.
			</p>
		</section>

		<section>
			{posts.length === 0 ? (
				<p style="font-style: italic; color: var(--ink-muted); text-align: center; padding: 48px 0;">
					No posts yet.
				</p>
			) : (
				<div class="post-table">
					{posts.map((post) => (
						<a class="post-row-link" href={`/blog/${post.id}/`}>
							<time class="post-date" datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
							<div class="post-title-block">
								<span class="post-title">{post.data.title}</span>
								{post.data.description && (
									<span class="post-desc">{post.data.description}</span>
								)}
							</div>
						</a>
					))}
				</div>
			)}
		</section>
	</div>
</Layout>
