---
import Layout from '../layouts/Layout.astro';

interface Project {
	title: string;
	attribution?: string;
	description: string;
	tags?: string[];
	repo?: string;
	demo?: string;
	link?: { label: string; href: string };
	year?: string;
}

// Selected work, newest first. Mostly proprietary builds — descriptions
// are intentionally light on internal detail. Personal/OSS work on GitHub.
const projects: Project[] = [
	{
		title: 'Enterprise RAG System',
		attribution: 'Built at Etiya',
		year: '2025—',
		description:
			'Production RAG pipeline over 500K+ documents with hybrid search (vector + BM25), HyDE query rewriting, cross-encoder re-ranking, and RAGAS evaluation — 92% recall@10, sub-3s responses.',
		tags: ['rag', 'llm', 'hybrid-search', 'faiss', 'ragas'],
	},
	{
		title: 'Agentic AI Platform',
		attribution: 'Built at Etiya',
		year: '2025—',
		description:
			'Multi-agent orchestration with LangGraph and CrewAI (ReAct + Plan-and-Execute) across 25+ tools, episodic and knowledge-graph memory, LangSmith tracing — 99.2% task completion.',
		tags: ['agents', 'langgraph', 'crewai', 'langsmith'],
	},
	{
		title: 'LLM Guardrail System',
		attribution: 'Built at Etiya',
		year: '2025—',
		description:
			'Multi-layer guardrails (Guardrails AI + NeMo Guardrails + custom) with PII detection, SHAP explainability, and Prometheus/Grafana observability — 89.2% harmful-output block rate, 5K+ concurrent requests.',
		tags: ['guardrails', 'llm-safety', 'pii', 'shap', 'redis'],
	},
	{
		title: 'Multi-Tenant NER Platform',
		attribution: 'Built at Etiya',
		year: '2025—',
		description:
			'Scalable Named Entity Recognition service with tenant-specific isolation and automated model selection based on SLAs — sub-200ms inference latency.',
		tags: ['nlp', 'ner', 'multi-tenant', 'inference'],
	},
	{
		title: 'Code-Generation LLM Fine-tuning',
		attribution: 'Built at Etiya',
		year: '2025',
		description:
			'LoRA fine-tuning of large code models on Hugging Face for domain-specific completion — +40% accuracy at −90% training cost, with A/B testing for adapter swapping.',
		tags: ['llm', 'fine-tuning', 'lora', 'huggingface', 'pytorch'],
	},
	{
		title: 'ISO 20022 / SWIFT MT-MX NLP Pipeline',
		attribution: 'Built at Im-Par (Frankfurt)',
		year: '2023—2025',
		description:
			'NLP pipelines in Python to validate and auto-generate compliant financial messages (ISO 20022, SWIFT MT/MX) for regulated workflows.',
		tags: ['nlp', 'fintech', 'compliance', 'iso-20022', 'swift'],
	},
	{
		title: 'Graph-Based Fraud Detection',
		attribution: 'Built at Im-Par (Frankfurt)',
		year: '2023—2025',
		description:
			'Graph systems on Neo4j + GraphQL over large-scale financial datasets, combining link prediction, clustering, and anomaly detection with Pandas/Spark mining for real-time signals.',
		tags: ['graphs', 'neo4j', 'fraud-detection', 'anomaly-detection'],
	},
	{
		title: 'Healthcare Activity Recognition',
		attribution: 'Built at Tiga (Ankara)',
		year: '2021—2023',
		description:
			'Edge-to-cloud sensor-fusion pipeline (ESP-32 + Raspberry Pi) with PCA/FFT/LDA preprocessing and an ensemble of classical ML + CNN models deployed for on-device inference.',
		tags: ['healthcare', 'edge-ml', 'sensor-fusion', 'cnn', 'xgboost'],
	},
];
---

<Layout title="projects" description="Selected production ML and engineering work by Berk Kırık.">
	<div class="stack">
		<span class="eyebrow">01 — projects</span>
		<h1>Selected work</h1>
		<p>
			Most of this is proprietary, so descriptions are light on internal detail.
			Open-source side projects live on{' '}
			<a href="https://github.com/Berkkirik" target="_blank" rel="noopener">GitHub</a>;
			peer-reviewed work is on the <a href="/resume/#publications">resume</a>.
		</p>
	</div>

	<section aria-label="Projects list">
		<ul>
			{projects.map((p) => (
				<li class="entry">
					<span class="meta">
						{p.year}
						{p.attribution ? ` · ${p.attribution}` : ''}
					</span>
					<h2>{p.title}</h2>
					<p>{p.description}</p>
					{p.tags && p.tags.length > 0 && (
						<ul class="tags">
							{p.tags.map((t) => <li>{t}</li>)}
						</ul>
					)}
				</li>
			))}
		</ul>
	</section>
</Layout>
