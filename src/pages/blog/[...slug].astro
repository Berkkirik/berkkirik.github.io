---
import Layout from '../../layouts/Layout.astro';
import HeroMotif from '../../components/HeroMotif.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog', (p) =>
		import.meta.env.PROD ? !p.data.draft : true,
	);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) => d.toISOString().slice(0, 10);

// Reading-time estimate: ~225 words/min for technical prose
const wordCount = post.body
	? post.body.replace(/```[\s\S]*?```/g, '').split(/\s+/).filter(Boolean).length
	: 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 225));
---

<Layout
	title={post.data.title}
	description={post.data.description}
	article={{
		publishedTime: post.data.pubDate.toISOString(),
		modifiedTime: post.data.updatedDate?.toISOString(),
		tags: post.data.tags,
	}}
>
	{/* Scroll-driven reading progress bar — pure CSS via animation-timeline. */}
	<div class="reading-progress" aria-hidden="true"><span></span></div>

	<article class="shell">
		<header style="margin-bottom: 48px;">
			<p style="font-family: var(--font-mono); font-size: 12px; color: var(--ink-faint); text-transform: lowercase; margin-bottom: 12px;">
				<a href="/blog/" style="text-decoration: none; color: var(--ink-faint);">/notes</a>
				<span> · </span>
				<time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
				{post.data.updatedDate && (
					<><span> · updated </span><time datetime={post.data.updatedDate.toISOString()}>{fmt(post.data.updatedDate)}</time></>
				)}
				<span> · {readingMinutes} min read</span>
				{post.data.tags && post.data.tags.length > 0 && (
					<><span> · </span>{post.data.tags.map((t) => `#${t}`).join(' ')}</>
				)}
				{post.data.draft && <span> · DRAFT</span>}
			</p>
			<h1 class="t-display" style="margin-bottom: 16px;">{post.data.title}</h1>
			{post.data.description && (
				<p class="t-lead">{post.data.description}</p>
			)}
		</header>

		{post.data.heroMotif && (
			<HeroMotif name={post.data.heroMotif} label={`Decorative motif for ${post.data.title}`} />
		)}

		<div class="prose">
			<Content />
		</div>

		<footer style="margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--rule); font-family: var(--font-serif); font-style: italic; color: var(--ink-soft);">
			<a href="/blog/">← all notes</a>
		</footer>
	</article>
</Layout>
