---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config';
---

<Layout title="" description={SITE.description}>
	<article class="shell">
		<header class="stack" style="gap: 24px; margin-bottom: 48px;">
			<p class="t-meta">README</p>
			<img
				src="/photo.jpg"
				alt="Portrait of Berk Kırık"
				width="120"
				height="120"
				class="portrait"
				loading="eager"
				decoding="async"
			/>
			<h1 class="t-display">
				<em>Berk Kırık</em> is a Senior AI Engineer.
			</h1>
		</header>

		<div class="stack" style="gap: 24px;">
			<p class="t-lead">
				Five years building production AI systems — LLMs, RAG, agentic
				platforms, multi-tenant NER, and the Kubernetes infrastructure
				underneath. Currently at <a href="https://www.etiya.com/" target="_blank" rel="noopener">Etiya</a>;
				previously at <a href="https://im-par.de/" target="_blank" rel="noopener">Im-Par</a>
				in Frankfurt and <a href="https://www.tigahealth.com/" target="_blank" rel="noopener">Tiga</a>
				in Ankara.
			</p>

			<p class="t-body">
				Currently doing an <em>MSc in Computer Engineering</em> at Ankara
				University — formal complement to the engineering work, and a way to
				keep one foot in research while the other is in production.
			</p>

			<p class="t-body">
				This site is, in roughly equal parts, a place to keep my work in one
				place, to write down what I learn from production AI, and to read more
				slowly than the internet usually allows. There are four corners of it:
			</p>

			<ol class="numbered" style="margin-top: 24px;">
				<li>
					<a class="title" href="/projects/">Projects</a>
					<span class="date">work</span>
					<span class="annotation">
						Selected production builds — RAG, agentic AI, guardrails, NER,
						fraud detection, healthcare sensor fusion. Mostly proprietary; descriptions
						are deliberately light on internal detail.
					</span>
				</li>
				<li>
					<a class="title" href="/blog/">Notes</a>
					<span class="date">writing</span>
					<span class="annotation">
						Occasional short essays — production AI, LLMs, agents, and the
						unglamorous infrastructure around them.
					</span>
				</li>
				<li>
					<a class="title" href="/resume/">Curriculum vitae</a>
					<span class="date">on-site</span>
					<span class="annotation">
						Full experience, education, skills, publications, and languages —
						mirrored from the PDF below.
					</span>
				</li>
				<li>
					<a class="title" href={SITE.resumePath} target="_blank" rel="noopener">CV (PDF)</a>
					<span class="date">download</span>
					<span class="annotation">
						The authoritative source.
					</span>
				</li>
			</ol>

			<p class="t-body" style="margin-top: 48px;">
				Reachable by <a href="mailto:berk.kirik@outlook.com">email</a>,
				on <a href="https://github.com/Berkkirik" target="_blank" rel="me noopener">GitHub</a>,
				and on <a href="https://www.linkedin.com/in/berkkirik/" target="_blank" rel="me noopener">LinkedIn</a>.
				Academic record on <a href="https://orcid.org/0009-0004-5045-3048" target="_blank" rel="me noopener">ORCID</a>.
			</p>
		</div>
	</article>
</Layout>
