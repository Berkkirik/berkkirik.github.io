---
import '../styles/global.css';
import { SITE, NAV, SOCIALS } from '../config';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = SITE.description } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isCurrent(href: string): boolean {
	const normalized = href.replace(/\/$/, '') || '/';
	if (normalized === '/') return currentPath === '/';
	return currentPath === normalized || currentPath.startsWith(normalized + '/');
}

const footerSocial = SOCIALS.filter((s) => s.label !== 'rss');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title={`${SITE.title} — Blog`} href="/rss.xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={SITE.author} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={SITE.title} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />

		<meta name="theme-color" content="#f6f1e7" />
	</head>
	<body>
		<a class="sr-only" href="#main">Skip to content</a>

		<header class="masthead" role="banner">
			<div class="masthead-inner">
				<a class="masthead-brand" href="/" aria-label={`${SITE.author} — home`}>
					<span>{SITE.author}</span>
					<span class="masthead-version">/ v1</span>
				</a>

				<nav class="masthead-nav" aria-label="Primary">
					{NAV.filter((item) => item.href !== '/').map((item) => (
						<a
							href={item.href}
							aria-current={isCurrent(item.href) ? 'page' : undefined}
						>{item.label}</a>
					))}
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="colophon" role="contentinfo">
			<div class="colophon-inner">
				<p>
					<em>Berk Kırık</em> is a Senior AI Engineer based in Ankara, Türkiye.
					Reachable by <a href="mailto:berk.kirik@outlook.com">email</a> and on
					{' '}{footerSocial.filter((s) => s.label !== 'email').map((s, i, arr) => (
						<>
							<a
								href={s.href}
								target={s.external ? '_blank' : undefined}
								rel={s.external ? 'me noopener' : undefined}
							>{s.label}</a>{i < arr.length - 1 ? ', ' : ''}
						</>
					))}.
				</p>

				<div class="legal">
					<span>© {new Date().getFullYear()} Berk Kırık</span>
					<span>Set in Newsreader</span>
					<span>Built with Astro · GitHub Pages</span>
					<a href="/rss.xml" class="no-underline" style="font-style: normal;">rss</a>
				</div>
			</div>
		</footer>
	</body>
</html>
