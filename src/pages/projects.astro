---
import Layout from '../layouts/Layout.astro';
import ProjectIcon from '../components/ProjectIcon.astro';

type IconName =
	| 'rag'
	| 'agents'
	| 'guardrails'
	| 'ner'
	| 'finetune'
	| 'swift'
	| 'graph'
	| 'microservices'
	| 'healthcare';

interface Project {
	title: string;
	attribution?: string;
	year?: string;
	description: string;
	tags?: string[];
	icon?: IconName;
}

const projects: Project[] = [
	{
		title: 'Enterprise RAG System',
		attribution: 'Etiya',
		year: '2025—',
		description:
			'Production RAG over 500K+ documents — hybrid search (vector + BM25), HyDE rewriting, cross-encoder re-ranking, RAGAS evaluation. 92% recall@10, sub-3s responses.',
		tags: ['rag', 'llm', 'faiss', 'ragas'],
		icon: 'rag',
	},
	{
		title: 'Agentic AI Platform',
		attribution: 'Etiya',
		year: '2025—',
		description:
			'Multi-agent orchestration with LangGraph + CrewAI (ReAct, Plan-and-Execute) across 25+ tools, with episodic and knowledge-graph memory, LangSmith tracing. 99.2% task completion.',
		tags: ['agents', 'langgraph', 'crewai', 'langsmith'],
		icon: 'agents',
	},
	{
		title: 'LLM Guardrail System',
		attribution: 'Etiya',
		year: '2025—',
		description:
			'Multi-layer guardrails (Guardrails AI + NeMo + custom) with PII detection, SHAP explainability, monitoring app (React / FastAPI / PostgreSQL). 89.2% blocked, 5K+ concurrent.',
		tags: ['guardrails', 'pii', 'shap', 'redis'],
		icon: 'guardrails',
	},
	{
		title: 'Multi-Tenant NER Platform',
		attribution: 'Etiya',
		year: '2025—',
		description:
			'Scalable NER serving multiple enterprise clients with tenant-specific isolation and SLA-based model selection. Sub-200ms inference.',
		tags: ['nlp', 'ner', 'multi-tenant'],
		icon: 'ner',
	},
	{
		title: 'Code-Generation Fine-tuning',
		attribution: 'Etiya',
		year: '2025',
		description:
			'LoRA fine-tuning of large code models on Hugging Face for domain-specific completion. +40% accuracy, −90% training cost, A/B adapter swapping.',
		tags: ['lora', 'huggingface', 'pytorch'],
		icon: 'finetune',
	},
	{
		title: 'ISO 20022 / SWIFT NLP Pipeline',
		attribution: 'Im-Par · Frankfurt',
		year: '2023—2025',
		description:
			'NLP pipelines in Python to validate and auto-generate compliant financial messages (ISO 20022, SWIFT MT/MX) for regulated workflows.',
		tags: ['nlp', 'fintech', 'compliance'],
		icon: 'swift',
	},
	{
		title: 'Graph-Based Fraud Detection',
		attribution: 'Im-Par · Frankfurt',
		year: '2023—2025',
		description:
			'Graph systems on Neo4j + GraphQL over large financial datasets — link prediction, clustering, anomaly detection, with Pandas/Spark mining for real-time signals.',
		tags: ['neo4j', 'fraud-detection', 'spark'],
		icon: 'graph',
	},
	{
		title: 'Banking-Platform Microservices',
		attribution: 'Im-Par · Frankfurt',
		year: '2023—2025',
		description:
			'Cloud-native banking platform: Golang for performance-critical services, Python / Django for AI orchestration. gRPC + REST, KrakenD gateway, Keycloak RBAC/ABAC, custom Kubernetes operators.',
		tags: ['golang', 'kubernetes', 'krakend'],
		icon: 'microservices',
	},
	{
		title: 'Healthcare Activity Recognition',
		attribution: 'Tiga · Ankara',
		year: '2021—2023',
		description:
			'Edge-to-cloud sensor-fusion pipeline (ESP-32 + Raspberry Pi). PCA / FFT / LDA preprocessing, ensemble of classical ML + CNN models, on-device mobile inference.',
		tags: ['edge-ml', 'sensor-fusion', 'cnn'],
		icon: 'healthcare',
	},
];
---

<Layout
	title="projects"
	description="Selected production AI and engineering work by Berk Kırık."
>
	<div class="shell-wide">
		<section class="page-hero">
			<p class="eyebrow">/projects</p>
			<h1>Selected work.</h1>
			<p class="lead">
				Most of this is proprietary, so descriptions are deliberately light on
				internal detail. Open-source side projects live on{' '}
				<a href="https://github.com/Berkkirik" target="_blank" rel="noopener">GitHub</a>;
				peer-reviewed work is on the <a href="/resume/#publications">resume</a>.
			</p>
		</section>

		<section>
			<ol class="work-grid" reversed style="list-style: none;">
				{projects.map((p) => (
					<li class="work-item">
						<div class="meta">
							<span>{p.year}</span>
							{p.attribution && <span class="dot">·</span>}
							{p.attribution && <span>{p.attribution}</span>}
						</div>
						<h3>
							{p.icon && <ProjectIcon name={p.icon} />}
							<span>{p.title}</span>
						</h3>
						<p>{p.description}</p>
						{p.tags && p.tags.length > 0 && (
							<div class="tags">
								{p.tags.map((t) => <span class="tag">{t}</span>)}
							</div>
						)}
					</li>
				))}
			</ol>
		</section>
	</div>
</Layout>
