---
import Layout from '../../layouts/Layout.astro';
import RainbowRule from '../../components/RainbowRule.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog', (p) =>
		import.meta.env.PROD ? !p.data.draft : true,
	);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout title={post.data.title} description={post.data.description}>
	<article>
		<header class="stack stack-sm">
			<span class="eyebrow">
				<time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
				{post.data.updatedDate && (
					<span> · updated {fmt(post.data.updatedDate)}</span>
				)}
				{post.data.tags.length > 0 && (
					<span> · {post.data.tags.map((t) => `#${t}`).join(' ')}</span>
				)}
				{post.data.draft && <span> · DRAFT</span>}
			</span>
			<h1>{post.data.title}</h1>
		</header>

		<div class="prose" style="margin-top: 32px;">
			<Content />
		</div>

		<RainbowRule />

		<p class="small" style="text-transform: none; letter-spacing: 0.02em;">
			<a href="/blog/">← back to blog</a>
		</p>
	</article>
</Layout>
