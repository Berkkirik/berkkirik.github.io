---
/**
 * ProjectIcon — small monochrome inline SVG used as a leading glyph on
 * each project entry in /projects. Single-stroke, fills inherit
 * currentColor from `.work-item .project-icon` (default: --accent-2).
 *
 * Icons share a 24×24 viewBox and rely on global stroke styles defined in
 * `.work-item .project-icon svg` (1.4 stroke, round line caps and joins).
 */
interface Props {
	name:
		| 'rag'
		| 'agents'
		| 'guardrails'
		| 'ner'
		| 'finetune'
		| 'swift'
		| 'graph'
		| 'microservices'
		| 'healthcare';
}

const { name } = Astro.props;
---

<span class="project-icon" aria-hidden="true">
	{name === 'rag' && (
		<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
			{/* stacked docs + magnifier */}
			<rect x="3" y="4" width="11" height="14" rx="1" />
			<path d="M 6 7 L 11 7 M 6 10 L 11 10 M 6 13 L 9 13" />
			<circle cx="17" cy="15" r="3.2" />
			<path d="M 19.4 17.4 L 21.5 19.5" />
		</svg>
	)}

	{name === 'agents' && (
		<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
			{/* three connected nodes (graph) */}
			<circle cx="6" cy="7" r="2" />
			<circle cx="18" cy="7" r="2" />
			<circle cx="12" cy="18" r="2" />
			<path d="M 8 7 L 16 7 M 7.2 9 L 11 16 M 16.8 9 L 13 16" />
		</svg>
	)}

	{name === 'guardrails' && (
		<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
			{/* shield */}
			<path d="M 12 3 L 20 6 L 20 12 C 20 17, 16 20, 12 21 C 8 20, 4 17, 4 12 L 4 6 Z" />
			<path d="M 9 12 L 11.5 14.5 L 15.5 10" />
		</svg>
	)}

	{name === 'ner' && (
		<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
			{/* label / tag */}
			<path d="M 3 3 L 13 3 L 21 11 L 13 19 L 3 19 Z" />
			<circle cx="7" cy="11" r="1.4" />
		</svg>
	)}

	{name === 'finetune' && (
		<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
			{/* angle brackets with a small spark */}
			<path d="M 7 7 L 3 12 L 7 17" />
			<path d="M 17 7 L 21 12 L 17 17" />
			<path d="M 10 18 L 14 6" />
			<path d="M 15.5 4 L 16 6 L 18 6.5 L 16 7 L 15.5 9 L 15 7 L 13 6.5 L 15 6 Z" />
		</svg>
	)}

	{name === 'swift' && (
		<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
			{/* document with checkmark */}
			<path d="M 5 3 L 15 3 L 19 7 L 19 21 L 5 21 Z" />
			<path d="M 15 3 L 15 7 L 19 7" />
			<path d="M 8 14 L 11 17 L 16 11" />
		</svg>
	)}

	{name === 'graph' && (
		<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
			{/* graph with one highlighted (alert) node */}
			<circle cx="5" cy="6" r="1.6" />
			<circle cx="19" cy="6" r="1.6" />
			<circle cx="5" cy="18" r="1.6" />
			<circle cx="19" cy="18" r="1.6" />
			<circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="none" />
			<path d="M 6.4 6.8 L 10 11 M 17.6 6.8 L 14 11 M 6.4 17.2 L 10 13 M 17.6 17.2 L 14 13" />
		</svg>
	)}

	{name === 'microservices' && (
		<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
			{/* three stacked cubes (isometric) */}
			<path d="M 12 3 L 20 7 L 20 15 L 12 19 L 4 15 L 4 7 Z" />
			<path d="M 4 7 L 12 11 L 20 7" />
			<path d="M 12 11 L 12 19" />
		</svg>
	)}

	{name === 'healthcare' && (
		<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
			{/* heartbeat / pulse line */}
			<path d="M 2 12 L 6 12 L 8 7 L 11 17 L 14 9 L 16 12 L 22 12" />
		</svg>
	)}
</span>
