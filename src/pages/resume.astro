---
import Layout from '../layouts/Layout.astro';
import { SITE, SOCIALS } from '../config';

interface Job {
	role: string;
	company: string;
	location: string;
	period: string;
	url?: string;
	summary?: string;
	bullets: { heading: string; body: string }[];
}

const experience: Job[] = [
	{
		role: 'Senior AI Engineer',
		company: 'Etiya',
		location: 'Türkiye',
		period: 'Sep 2025 — present',
		url: 'https://www.etiya.com/',
		summary: 'Production LLM and agentic-AI systems on a microservices architecture.',
		bullets: [
			{
				heading: 'Code-Generation Fine-tuning',
				body:
					'Used LoRA on Hugging Face to fine-tune large code models, boosting domain-specific code-completion accuracy by 40% while cutting training cost by 90%. Only 0.1% of model parameters needed tuning, with A/B testing for seamless adapter swapping.',
			},
			{
				heading: 'Multi-Tenant NER System',
				body:
					'Scalable Named Entity Recognition platform serving multiple enterprise clients with tenant-specific isolation, automated model selection based on SLAs, and sub-200ms inference latency.',
			},
			{
				heading: 'Guardrail System',
				body:
					'Multi-layer guardrails (Guardrails AI + NeMo + custom) blocking 89.2% of harmful outputs. PII detection at 97% accuracy across 15+ categories, SHAP explainability, full-stack monitoring app (React / FastAPI / PostgreSQL), Redis caching for sub-50ms responses, Prometheus / Grafana observability — handling 5K+ concurrent requests.',
			},
			{
				heading: 'Enterprise RAG System',
				body:
					'Production pipeline processing 500K+ documents with hybrid search (vector + BM25), advanced chunking, HyDE query rewriting, cross-encoder re-ranking, and RAGAS evaluation. 92% recall@10, 45% reduced hallucinations, sub-3s responses, 20+ file formats.',
			},
			{
				heading: 'Agentic AI Development',
				body:
					'Multi-agent orchestration with LangGraph / CrewAI (ReAct + Plan-and-Execute) across 25+ tools. Autonomous code-review agents, multi-agent collaboration (researcher / analyst / writer / critic), episodic + knowledge-graph memory, LangSmith tracing, self-healing pipelines at 99.2% task completion, guardrail integration.',
			},
		],
	},
	{
		role: 'Data Scientist Team Lead / Backend Engineer',
		company: 'Im-Par',
		location: 'Frankfurt am Main, Germany',
		period: 'Sep 2023 — Sep 2025',
		url: 'https://im-par.de/',
		summary:
			'Led the ML pipeline lifecycle for financial-message compliance, fraud detection, and a cloud-native banking platform.',
		bullets: [
			{
				heading: 'ML Model Development & NLP Automation',
				body:
					'Led the full ML pipeline lifecycle for validating ISO 20022 and SWIFT MT/MX financial message formats. Built NLP-driven systems in Python to automate compliant message generation.',
			},
			{
				heading: 'LLM Fine-Tuning, Generative AI & RAG Integration',
				body:
					'Directed LLM fine-tuning for compliance, fraud detection, and message classification (Hugging Face, PyTorch). Integrated Generative AI for automated message construction and domain chatbots, RAG pipelines combining FAISS vector stores with LLMs for regulatory support.',
			},
			{
				heading: 'Graph-Based Fraud Detection & Data Mining',
				body:
					'Graph-based systems on Neo4j + GraphQL — link prediction, clustering, anomaly detection — combined with Pandas / Spark mining for real-time signals over large financial datasets.',
			},
			{
				heading: 'Backend Platform Engineering (Golang + Python)',
				body:
					'Designed and led a cloud-native banking platform: Golang for performance-critical services, Python / Django for AI orchestration. Globally distributed Agile teams.',
			},
			{
				heading: 'Microservices Architecture with gRPC & REST',
				body:
					'Production microservices (Golang + Python). gRPC for internal, REST for external. KrakenD as API gateway, Keycloak for RBAC + ABAC.',
			},
			{
				heading: 'Kubernetes Infrastructure & DevOps Automation',
				body:
					'Kubernetes-native infrastructure with custom Golang operators / controllers for dynamic orchestration and autoscaling. Shell scripts, cron jobs, GitOps-driven CI/CD pipelines.',
			},
			{
				heading: 'Agile Team Leadership',
				body:
					'Lead for the Data Science team across multiple Agile squads — sprint planning, retrospectives, cross-team collaboration with engineering and product.',
			},
		],
	},
	{
		role: 'Data Scientist',
		company: 'Tiga Information Technologies Inc.',
		location: 'Ankara, Türkiye',
		period: 'Aug 2021 — Sep 2023',
		url: 'https://www.tigahealth.com/',
		summary: 'Healthcare AI — sensor-fusion activity recognition from edge to mobile.',
		bullets: [
			{
				heading: 'Device & Sensor Integration',
				body:
					'Multi-device sensing pipeline using ESP-32 WiFi modules and Raspberry Pi to gather real-time motion, environmental, and location-based sensor data — for continuous edge monitoring.',
			},
			{
				heading: 'Data Processing & Synchronization',
				body:
					'Timestamp synchronization, noise filtering, and data normalization (Min-Max, Z-Score) for high-quality input to downstream ML. Handling for missing data, sensor drift, and latency.',
			},
			{
				heading: 'Feature Engineering & Dimensionality Reduction',
				body:
					'PCA, FFT, and LDA for feature extraction — improving signal separation between user activity classes, model interpretability, and computational overhead.',
			},
			{
				heading: 'Machine Learning & Deep Learning Models',
				body:
					'Decision Trees, SVM, Random Forest, and CNNs for activity classification from sensor streams. XGBoost and ensemble approaches for generalization and reducing overfitting.',
			},
			{
				heading: 'Backend API Development',
				body:
					'FastAPI for real-time inference APIs, Django for user data, authentication, and application logic. RESTful endpoints supporting mobile and web apps, with logging, feedback loops, and results visualization.',
			},
			{
				heading: 'Mobile App Deployment & Real-Time Feedback',
				body:
					'Mobile app interfaces embedding trained models for real-time alerts, personalized activity tracking, and adaptive feedback. Optimized model size and latency for on-device inference.',
			},
			{
				heading: 'Model Fine-Tuning & Performance Optimization',
				body:
					'Transfer learning, hyperparameter tuning, and data augmentation to reduce false positives. Refined CNN and NLP-based architectures for healthcare constraints and variability.',
			},
			{
				heading: 'Validation & Evaluation Techniques',
				body:
					'k-fold cross-validation, Grid Search, and Random Search to systematically evaluate and optimize model performance across diverse users and activity scenarios.',
			},
			{
				heading: 'Graph-Based Behavioral Analysis & Data Mining',
				body:
					'Neo4j + GraphQL + Pandas to model and query user behavior patterns through graph analysis. Actionable insights from streaming sensor data for healthcare and activity monitoring.',
			},
		],
	},
];

const education = [
	{
		degree: 'MSc, Computer Engineering',
		school: 'Ankara University',
		period: 'Feb 2026 — present',
		location: 'Ankara, Türkiye',
	},
	{
		degree: 'BSc, Biomedical Engineering',
		school: 'Ankara University',
		period: 'Aug 2018 — May 2024',
		location: 'Ankara, Türkiye',
		url: 'http://bme.eng.ankara.edu.tr',
		note: 'Foundation in signal processing, sensor systems, biological / medical data, and statistics — applied directly in later healthcare-AI and biological-classification work.',
	},
	{
		degree: 'Associate, Computer Programming',
		school: 'Istanbul University',
		period: 'Aug 2022 — Jul 2024',
		location: 'Istanbul, Türkiye',
		url: 'https://www.istanbul.edu.tr',
	},
];

const skills: Record<string, string[]> = {
	'Programming languages': ['Python', 'Go', 'C++', 'PHP', 'SQL'],
	'ML / Deep Learning': [
		'PyTorch',
		'TensorFlow',
		'Keras',
		'JAX / Flax',
		'Hugging Face',
		'LoRA',
		'XGBoost',
	],
	'LLM / agentic systems': [
		'LangGraph',
		'CrewAI',
		'LangSmith',
		'RAG (FAISS, BM25, HyDE)',
		'RAGAS',
		'Guardrails AI',
		'NeMo Guardrails',
	],
	'Backend & APIs': ['FastAPI', 'Django', 'Flask', 'Node.js', 'gRPC', 'REST', 'KrakenD'],
	'Data & graphs': [
		'PostgreSQL',
		'Oracle',
		'Redis',
		'Kafka',
		'Neo4j',
		'GraphQL',
		'Pandas',
		'Spark',
	],
	'Infra & DevOps': [
		'Kubernetes',
		'Docker',
		'Docker Swarm',
		'GitOps',
		'AWS',
		'Prometheus / Grafana',
		'Keycloak',
	],
	'Biomedical / domain': [
		'Signal processing (FFT, PCA, LDA)',
		'Sensor fusion',
		'Embedded systems (ESP-32, Raspberry Pi)',
		'Healthcare AI',
		'Biological data / classification',
	],
};

const publications = [
	{
		title:
			'Enhancing crayfish sex identification with Kolmogorov-Arnold networks and stacked autoencoders',
		venue: 'Nature — Scientific Reports',
		year: 2025,
		authors:
			'Yasin Atilkan, Berk Kırık, Eren Tuna Açıkbaş, Fatih Ekinci, Koray Açıcı, Tunç Aşuroğlu, Recep Benzer, Mehmet Serdar Güzel, Semra Benzer',
		summary:
			'KANs at 95–100% accuracy on tabular features; stacked-autoencoder + KAN architecture lifted image-feature performance ~3.5%. McNemar / Wilcoxon tests confirmed significant differences vs. SVM, MLPs, and naive Bayes.',
		link: 'https://www.nature.com/articles/s41598-025-34095-z',
	},
	{
		title:
			'Advancing Crayfish Disease Detection: A Comparative Study of Deep Learning and Canonical Machine Learning Techniques',
		venue: 'Peer-reviewed journal',
		year: 2024,
		authors:
			'Yasin Atilkan, Berk Kırık, Koray Açıcı, Recep Benzer, Fatih Ekinci, Mehmet Serdar Güzel',
		summary:
			'Hybrid RF-ResNet50 (ResNet50 features + Random Forest classifier) outperformed both pure deep-learning and canonical-ML models on an imbalanced dataset.',
	},
];

const certifications = [
	{
		title: 'Concurrency in Go',
		issuer: 'UC Irvine — Coursera',
		date: 'Dec 2023',
		link: 'https://coursera.org/verify/UZD%20D%20P5EM58E3',
	},
	{ title: 'Python for Data Science', issuer: 'Verified Certificate', date: 'May 2022' },
	{ title: 'Introduction to Linux', issuer: 'Verified Certificate', date: 'May 2022' },
	{ title: 'AI For Everyone (I & II)', issuer: 'e-Government Certificate' },
];

const languages = [
	{ name: 'Turkish', level: 'Native' },
	{
		name: 'English',
		level: 'Listening B2 · Reading C1 · Writing B2 · Speaking B2',
	},
	{
		name: 'German',
		level: 'Listening A1 · Reading A2 · Writing A2 · Speaking A1',
	},
];

const interests = [
	'Open-source contributions',
	'Swimming',
	'Basketball',
	'Chess puzzles',
];

const visibleSocials = SOCIALS.filter((s) => s.label !== 'rss');
---

<Layout
	title="resume"
	description="Resume of Berk Kırık — Senior AI Engineer. Five-plus years in production AI across fintech and healthcare."
>
	<div class="shell-wide">
		<section class="page-hero">
			<p class="eyebrow">/curriculum vitae</p>
			<h1>Berk Kırık.</h1>
			<p class="lead">
				Senior AI Engineer with 5+ years building production AI in microservices —
				LLMs, RAG, agentic AI, and the Kubernetes infrastructure underneath.
				Background spans fintech and healthcare; trained originally as a
				biomedical engineer.
			</p>
			<p style="font-family: var(--font-mono); font-size: 12px; color: var(--ink-faint); text-transform: lowercase; margin-top: 16px;">
				Ankara, Türkiye{' '}·{' '}
				<a href={SITE.resumePath} target="_blank" rel="noopener">pdf</a>
				{' · '}
				{visibleSocials.map((s, i) => (
					<>
						{i > 0 && ' · '}
						<a href={s.href} target={s.external ? '_blank' : undefined} rel={s.external ? 'me noopener' : undefined}>{s.label}</a>
					</>
				))}
			</p>
		</section>

		<!-- EXPERIENCE -->
		<section id="experience" style="margin-bottom: 80px;">
			<h2 class="t-h2" style="margin-bottom: 24px;">Experience</h2>
			<div class="cv-grid">
				{experience.map((job) => (
					<div class="cv-row">
						<div class="side">
							<span class="period">{job.period}</span>
							<span class="place">{job.location}</span>
						</div>
						<div class="body">
							<div class="role">{job.role}</div>
							<div class="where">
								{job.url ? (
									<a href={job.url} target="_blank" rel="noopener">{job.company}</a>
								) : job.company}
							</div>
							{job.summary && <div class="summary">{job.summary}</div>}
							<ul class="bullets">
								{job.bullets.map((b) => (
									<li><strong>{b.heading}.</strong> {b.body}</li>
								))}
							</ul>
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- EDUCATION -->
		<section id="education" style="margin-bottom: 80px;">
			<h2 class="t-h2" style="margin-bottom: 24px;">Education</h2>
			<div class="cv-grid">
				{education.map((e) => (
					<div class="cv-row">
						<div class="side">
							<span class="period">{e.period}</span>
							<span class="place">{e.location}</span>
						</div>
						<div class="body">
							<div class="role">{e.degree}</div>
							<div class="where">
								{e.url ? (
									<a href={e.url} target="_blank" rel="noopener">{e.school}</a>
								) : e.school}
							</div>
							{e.note && <div class="summary">{e.note}</div>}
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- SKILLS -->
		<section id="skills" style="margin-bottom: 80px;">
			<h2 class="t-h2" style="margin-bottom: 24px;">Skills</h2>
			<div class="skills-grid">
				{Object.entries(skills).map(([group, items]) => (
					<div class="skills-row">
						<span class="group">{group}</span>
						<span class="items">{items.join(' · ')}</span>
					</div>
				))}
			</div>
		</section>

		<!-- PUBLICATIONS -->
		<section id="publications" style="margin-bottom: 80px;">
			<h2 class="t-h2" style="margin-bottom: 24px;">Publications</h2>
			<div class="cv-grid">
				{publications.map((p) => (
					<div class="cv-row">
						<div class="side">
							<span class="period">{p.year}</span>
							<span class="place">{p.venue}</span>
						</div>
						<div class="body">
							<div class="role">
								{p.link ? (
									<a href={p.link} target="_blank" rel="noopener">{p.title}</a>
								) : p.title}
							</div>
							<div class="where">{p.authors}</div>
							{p.summary && <div class="summary">{p.summary}</div>}
						</div>
					</div>
				))}
			</div>
			<p style="font-family: var(--font-serif); font-style: italic; font-size: 15px; color: var(--ink-muted); margin-top: 16px;">
				Full record on <a href="https://orcid.org/0009-0004-5045-3048" target="_blank" rel="noopener">ORCID</a>.
			</p>
		</section>

		<!-- CERTIFICATIONS -->
		<section id="certifications" style="margin-bottom: 80px;">
			<h2 class="t-h2" style="margin-bottom: 24px;">Certifications</h2>
			<div class="skills-grid">
				{certifications.map((c) => (
					<div class="skills-row">
						<span class="group">{c.date ?? ''}</span>
						<span class="items">
							{c.link ? (
								<a href={c.link} target="_blank" rel="noopener"><strong>{c.title}</strong></a>
							) : (
								<strong>{c.title}</strong>
							)}
							{' — '}
							<em>{c.issuer}</em>
						</span>
					</div>
				))}
			</div>
		</section>

		<!-- LANGUAGES -->
		<section id="languages" style="margin-bottom: 80px;">
			<h2 class="t-h2" style="margin-bottom: 24px;">Languages</h2>
			<div class="skills-grid">
				{languages.map((l) => (
					<div class="skills-row">
						<span class="group">{l.name}</span>
						<span class="items">{l.level}</span>
					</div>
				))}
			</div>
		</section>

		<!-- INTERESTS -->
		<section id="interests">
			<h2 class="t-h2" style="margin-bottom: 16px;">Interests</h2>
			<p class="t-body" style="color: var(--ink-soft);">
				{interests.join(' · ')}
			</p>
		</section>
	</div>
</Layout>
