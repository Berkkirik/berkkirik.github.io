---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.filter((p) => import.meta.env.PROD ? !p.data.draft : true)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout
	title="blog"
	description="Writing by Berk Kırık on production ML, LLMs, agents, and the unglamorous infra around them."
	subNavCategory="Blog"
	subNavCta={{ label: 'Subscribe (RSS)', href: '/rss.xml' }}
>
	<!-- Hero tile (light) -->
	<section class="tile tile-light">
		<div class="tile-stack">
			<h1 class="t-display-lg">Writing.</h1>
			<p class="t-lead-airy">
				Short notes from production: LLMs, RAG, agents, the things that break and why.
				Subscribe via <a href="/rss.xml">RSS</a>.
			</p>
		</div>
	</section>

	<!-- Post list tile (parchment) -->
	<section class="tile tile-parchment" style="padding-top: 0; padding-bottom: var(--space-section);">
		<div class="tile-content-narrow">
			{posts.length === 0 ? (
				<p class="t-lead-airy" style="text-align: center;">No posts yet.</p>
			) : (
				<div class="post-list">
					{posts.map((post) => (
						<a class="post-row" href={`/blog/${post.id}/`}>
							<time class="date" datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
							<span class="title">{post.data.title}</span>
						</a>
					))}
				</div>
			)}
		</div>
	</section>
</Layout>

<style>
	a.post-row {
		text-decoration: none;
		color: inherit;
	}

	a.post-row:hover .title {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
