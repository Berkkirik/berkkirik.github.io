---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404" description="Page not found.">
	<div class="stack">
		<span class="eyebrow">404 — not found</span>
		<h1>This page doesn't exist.</h1>
		<p style="color: var(--fg-muted);">
			Maybe a stale link, maybe a typo. Either way, there's nothing here.
		</p>
		<p>
			<a href="/">← back home</a>
		</p>
	</div>
</Layout>
