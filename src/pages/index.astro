---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config';
---

<Layout title="" description={SITE.description}>
	<!-- Tile 1 — Hero (light) -->
	<section class="tile tile-light">
		<div class="tile-stack">
			<h1 class="t-hero">Berk Kırık.</h1>
			<p class="t-lead">
				Senior AI Engineer. Five years building production ML in microservices —
				LLMs, RAG, agentic AI, and the Kubernetes infrastructure underneath.
			</p>
			<div class="ctas">
				<a class="btn btn-primary" href="/projects/">View work</a>
				<a class="btn btn-secondary-pill" href="mailto:berk.kirik@outlook.com">Get in touch</a>
			</div>
		</div>
	</section>

	<!-- Tile 2 — Currently (dark) -->
	<section class="tile tile-dark">
		<div class="tile-stack">
			<p class="t-caption" style="color: var(--body-muted); text-transform: uppercase; letter-spacing: 0.08em;">
				Currently
			</p>
			<h2 class="t-display-lg" style="color: var(--body-on-dark);">
				Production ML at <a href="https://www.etiya.com/" target="_blank" rel="noopener" style="color: var(--primary-on-dark);">Etiya</a>.
			</h2>
			<p class="t-lead-airy" style="color: var(--body-muted);">
				LoRA fine-tuning. Multi-tenant NER at sub-200ms. Enterprise RAG over 500K
				documents. Agentic platforms with LangGraph and CrewAI. The unglamorous
				infra that makes them ship.
			</p>
			<div class="ctas">
				<a class="btn btn-primary" href="/resume/#experience">See the details</a>
			</div>
		</div>
	</section>

	<!-- Tile 3 — BE → AI bridge (parchment) -->
	<section class="tile tile-parchment">
		<div class="tile-stack">
			<p class="t-caption" style="text-transform: uppercase; letter-spacing: 0.08em;">
				Background
			</p>
			<h2 class="t-display-lg">Software Engineer.</h2>
			<p class="t-lead-airy">
				BSc in Biomedical Engineering at Ankara University taught me how
				signals from a body become decisions a system makes — and that
				foundation still sits underneath the work I do, from sensor-fusion
				healthcare AI at <a href="https://www.tigahealth.com/" target="_blank" rel="noopener">Tiga</a>
				to ongoing research on biological classification.
			</p>
			<div class="ctas">
				<a class="btn btn-secondary-pill" href="/resume/#education">Education</a>
				<a class="btn btn-secondary-pill" href="/resume/#publications">Publications</a>
			</div>
		</div>
	</section>

	<!-- Closing tile (light) -->
	<section class="tile tile-light">
		<div class="tile-stack">
			<h2 class="t-display-lg">Get in touch.</h2>
			<p class="t-lead-airy">
				Best reached by email. The full CV is one click away.
			</p>
			<div class="ctas">
				<a class="btn btn-primary" href="mailto:berk.kirik@outlook.com">Email me</a>
				<a class="btn btn-secondary-pill" href={SITE.resumePath} target="_blank" rel="noopener">Download CV</a>
			</div>
		</div>
	</section>
</Layout>
