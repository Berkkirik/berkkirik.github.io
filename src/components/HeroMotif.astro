---
/**
 * HeroMotif — small, restrained line-art SVG above a blog post.
 *
 * Each motif is a single-stroke drawing using `currentColor` so the surrounding
 * `.hero-motif` container controls the actual color (default: --accent-2).
 *
 * To add a new motif: append a new case below with a `viewBox` ~ 240×60 and
 * any number of <path>/<rect>/<circle> elements. Keep stroke-width = 1.4
 * to match the rest of the site's line art.
 */
interface Props {
	name: 'intro' | 'recursion' | 'stack';
	label?: string;
}

const { name, label } = Astro.props;
---

<figure
	class="hero-motif"
	role={label ? 'img' : 'presentation'}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
>
	{name === 'intro' && (
		<svg
			viewBox="0 0 240 60"
			xmlns="http://www.w3.org/2000/svg"
			stroke-width="1.4"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			{/* a long page-line with a small ink-blot near the center —
			    "a starting mark on the page" */}
			<path d="M 10 30 L 230 30" />
			<circle cx="120" cy="30" r="3.2" fill="currentColor" stroke="none" />
			{/* small serif flourish underneath */}
			<path d="M 96 42 Q 120 50, 144 42" />
		</svg>
	)}

	{name === 'recursion' && (
		<svg
			viewBox="0 0 240 80"
			xmlns="http://www.w3.org/2000/svg"
			stroke-width="1.4"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			{/* three nested rounded frames + a small return arrow on the right
			    showing the recursive call returning back to the parent */}
			<rect x="40" y="14" width="160" height="52" rx="3" />
			<rect x="62" y="24" width="116" height="32" rx="3" />
			<rect x="84" y="34" width="72" height="12" rx="2" />
			{/* return arrow */}
			<path d="M 200 40 C 220 40, 220 12, 204 12" />
			<path d="M 208 7 L 204 12 L 200 17" />
		</svg>
	)}

	{name === 'stack' && (
		<svg
			viewBox="0 0 240 80"
			xmlns="http://www.w3.org/2000/svg"
			stroke-width="1.4"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			{/* three stacked horizontal slabs of decreasing width —
			    "decomposition / chunking" */}
			<rect x="40" y="18" width="160" height="10" rx="2" />
			<rect x="60" y="34" width="120" height="10" rx="2" />
			<rect x="80" y="50" width="80" height="10" rx="2" />
		</svg>
	)}
</figure>
