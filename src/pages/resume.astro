---
import Layout from '../layouts/Layout.astro';
import { SITE, SOCIALS } from '../config';

interface Job {
	role: string;
	company: string;
	location: string;
	period: string;
	url?: string;
	summary?: string;
	bullets: { heading: string; body: string }[];
}

// ---- Experience: every CV sub-heading rendered as its own bullet ----
const experience: Job[] = [
	{
		role: 'Senior AI Engineer',
		company: 'Etiya',
		location: 'Türkiye',
		period: 'Sep 2025 — present',
		url: 'https://www.etiya.com/',
		summary:
			'Building production LLM and agentic-AI systems on a microservices architecture.',
		bullets: [
			{
				heading: 'Code-Generation Fine-tuning',
				body:
					'Used LoRA on Hugging Face to fine-tune large code models, boosting domain-specific code-completion accuracy by 40% while cutting training cost by 90%. Only 0.1% of model parameters needed tuning, with A/B testing for seamless adapter swapping.',
			},
			{
				heading: 'Multi-Tenant NER System',
				body:
					'Built a scalable Named Entity Recognition platform serving multiple enterprise clients with tenant-specific isolation, automated model selection based on SLAs, and sub-200ms inference latency.',
			},
			{
				heading: 'Guardrail System',
				body:
					'Integrated Guardrails AI, NeMo Guardrails, and custom layers to block 89.2% of harmful outputs. Includes PII detection at 97% accuracy across 15+ categories, explainable AI with SHAP, a full-stack monitoring app (React / FastAPI / PostgreSQL), Redis caching for sub-50ms response times, and Prometheus / Grafana observability — all on a microservices architecture handling 5K+ concurrent requests.',
			},
			{
				heading: 'Enterprise RAG System',
				body:
					'Production pipeline processing 500K+ documents with hybrid search (vector + BM25), advanced chunking, query rewriting (HyDE), cross-encoder re-ranking, and RAGAS evaluation. Achieved 92% recall@10, reduced hallucinations by 45%, and optimized to sub-3-second responses with support for 20+ file formats.',
			},
			{
				heading: 'Agentic AI Development',
				body:
					'Multi-agent orchestration using LangGraph / CrewAI with ReAct and Plan-and-Execute patterns across 25+ tools. Includes autonomous code-review agents, multi-agent collaboration (researcher / analyst / writer / critic), episodic and knowledge-graph memory, LangSmith tracing, and self-healing pipelines at 99.2% task completion — with guardrail integration for safe autonomous operation.',
			},
		],
	},
	{
		role: 'Data Scientist Team Lead / Backend Engineer',
		company: 'Im-Par',
		location: 'Frankfurt am Main, Germany',
		period: 'Sep 2023 — Sep 2025',
		url: 'https://im-par.de/',
		summary:
			'Led the ML pipeline lifecycle for financial-message compliance, fraud detection, and a cloud-native banking platform.',
		bullets: [
			{
				heading: 'ML Model Development & NLP Automation',
				body:
					'Led the full lifecycle of ML pipelines designed to validate financial message formats such as ISO 20022 and SWIFT MT/MX. Built NLP-driven systems in Python to automate the generation of compliant message structures, reducing manual intervention and improving overall accuracy and process efficiency.',
			},
			{
				heading: 'LLM Fine-Tuning, Generative AI & RAG Integration',
				body:
					'Directed the fine-tuning of large language models for financial compliance, fraud detection, and message classification using transfer learning, prompt engineering, and hyperparameter tuning (Hugging Face, PyTorch). Integrated Generative AI for automated message construction and domain-specific chatbots, and developed RAG pipelines combining custom FAISS vector stores with LLMs for regulatory support.',
			},
			{
				heading: 'Graph-Based Fraud Detection & Data Mining',
				body:
					'Built and deployed graph-based systems on Neo4j and GraphQL to detect fraud within large-scale financial datasets — link prediction, clustering, and anomaly detection — combined with Pandas / Spark mining for real-time, actionable insights.',
			},
			{
				heading: 'Backend Platform Engineering (Golang + Python)',
				body:
					'Designed and led development of a cloud-native banking platform using Golang for performance-critical services and Python / Django for AI orchestration and API logic. Focused on modularity, horizontal scalability, and resilience, working closely with globally distributed Agile teams to align backend architecture with evolving AI workloads, compliance needs, and business goals.',
			},
			{
				heading: 'Microservices Architecture with gRPC & REST',
				body:
					'Built a production-grade microservices ecosystem (Golang + Python). gRPC for fast internal communication and REST for secure external integrations. Deployed KrakenD as the API gateway for traffic flow, request aggregation, and observability, and integrated Keycloak for enterprise security with RBAC + ABAC for fine-grained access control and regulatory compliance.',
			},
			{
				heading: 'Kubernetes Infrastructure & DevOps Automation',
				body:
					'Developed and maintained a Kubernetes-native infrastructure for backend and ML workloads across cloud and hybrid environments. Built custom Kubernetes operators / controllers in Golang for dynamic orchestration and autoscaling. Automated deployments via shell scripts, cron jobs, and GitOps-driven CI/CD pipelines.',
			},
			{
				heading: 'Agile Team Leadership & Cross-Functional Collaboration',
				body:
					'Acted as Lead for the Data Science team, overseeing deliverables across multiple Agile squads. Led sprint planning, daily standups, and retrospectives, collaborating across data science, engineering, and product to accelerate AI-feature development.',
			},
		],
	},
	{
		role: 'Data Scientist',
		company: 'Tiga Information Technologies Inc.',
		location: 'Ankara, Türkiye',
		period: 'Aug 2021 — Sep 2023',
		url: 'https://www.tigahealth.com/',
		summary:
			'Healthcare AI — sensor-fusion activity recognition from edge to mobile.',
		bullets: [
			{
				heading: 'Device & Sensor Integration',
				body:
					'Designed a multi-device sensing pipeline using ESP-32 WiFi modules and Raspberry Pi boards to gather real-time data from motion, environmental, and location-based sensors — focused on reliable data capture and wireless communication for continuous monitoring in edge environments.',
			},
			{
				heading: 'Data Processing & Synchronization',
				body:
					'Implemented timestamp synchronization, noise filtering, and data normalization (Min-Max scaling, Z-Score standardization) for high-quality input to downstream ML. Designed preprocessing workflows to handle missing data, sensor drift, and latency in real-time systems.',
			},
			{
				heading: 'Feature Engineering & Dimensionality Reduction',
				body:
					'Applied Principal Component Analysis (PCA), Fast Fourier Transform (FFT), and Linear Discriminant Analysis (LDA) for feature extraction — improving signal separation between user activity classes, model interpretability, and computational overhead.',
			},
			{
				heading: 'Machine Learning & Deep Learning Models',
				body:
					'Trained Decision Trees, SVM, Random Forest, and CNNs to classify user activities from sensor streams with high precision, using XGBoost and ensemble approaches to enhance generalization and mitigate overfitting in real-world use cases.',
			},
			{
				heading: 'Backend API Development with Django & FastAPI',
				body:
					'Built backend services using FastAPI for real-time inference APIs and Django for managing user data, authentication, and application logic. Developed RESTful endpoints to support mobile and web apps, with logging, feedback loops, and results visualization for end users and clinical reviewers — ensuring high performance and low latency across distributed environments.',
			},
			{
				heading: 'Mobile App Deployment & Real-Time Feedback',
				body:
					'Built mobile app interfaces that embedded trained models to deliver real-time alerts, personalized activity tracking, and adaptive feedback. Optimized model size and latency for seamless on-device inference.',
			},
			{
				heading: 'Model Fine-Tuning & Performance Optimization',
				body:
					'Applied transfer learning, hyperparameter tuning, and data augmentation to improve robustness and reduce false positives — refining CNN and NLP-based architectures to suit real-world healthcare constraints and variability.',
			},
			{
				heading: 'Validation & Evaluation Techniques',
				body:
					'Used k-fold cross-validation, Grid Search, and Random Search to systematically evaluate and optimize model performance — emphasizing consistent evaluation across diverse users and activity scenarios.',
			},
			{
				heading: 'Graph-Based Behavioral Analysis & Data Mining',
				body:
					'Modeled user behavior patterns in Neo4j + GraphQL + Pandas through graph analysis. Extracted actionable insights from streaming sensor data and applied advanced data mining to support decision-making in healthcare and activity-monitoring contexts.',
			},
		],
	},
];

// ---- Education ----
const education = [
	{
		degree: 'MSc, Computer Engineering',
		school: 'Ankara University',
		period: 'Feb 2026 — present',
		location: 'Ankara, Türkiye',
	},
	{
		degree: 'BSc, Biomedical Engineering',
		school: 'Ankara University',
		period: 'Aug 2018 — May 2024',
		location: 'Ankara, Türkiye',
		url: 'http://bme.eng.ankara.edu.tr',
		note: 'Foundation in signal processing, sensor systems, biological/medical data, and statistics — directly applied in later healthcare-AI and biological-classification work.',
	},
	{
		degree: 'Associate, Computer Programming',
		school: 'Istanbul University',
		period: 'Aug 2022 — Jul 2024',
		location: 'Istanbul, Türkiye',
		url: 'https://www.istanbul.edu.tr',
	},
];

// ---- Skills (CV-grounded; items appear in CV BECERILER or work-experience text) ----
const skills: Record<string, string[]> = {
	'Programming languages': ['Python', 'Go', 'C++', 'PHP', 'SQL'],
	'ML / Deep Learning': [
		'PyTorch',
		'TensorFlow',
		'Keras',
		'JAX / Flax',
		'Hugging Face',
		'LoRA',
		'XGBoost',
	],
	'LLM / Agentic systems': [
		'LangGraph',
		'CrewAI',
		'LangSmith',
		'RAG (FAISS, BM25, HyDE)',
		'RAGAS',
		'Guardrails AI',
		'NeMo Guardrails',
	],
	'Backend & APIs': ['FastAPI', 'Django', 'Flask', 'Node.js', 'gRPC', 'REST', 'KrakenD'],
	'Data & graphs': [
		'PostgreSQL',
		'Oracle',
		'Redis',
		'Kafka',
		'Neo4j',
		'GraphQL',
		'Pandas',
		'Spark',
	],
	'Infra & DevOps': [
		'Kubernetes',
		'Docker',
		'Docker Swarm',
		'GitOps',
		'AWS',
		'Prometheus / Grafana',
		'Keycloak',
	],
	'Biomedical / domain': [
		'Signal processing (FFT, PCA, LDA)',
		'Sensor fusion',
		'Embedded systems (ESP-32, Raspberry Pi)',
		'Healthcare AI',
		'Biological data / classification',
	],
};

// ---- Publications ----
const publications = [
	{
		title:
			'Enhancing crayfish sex identification with Kolmogorov-Arnold networks and stacked autoencoders',
		venue: 'Nature — Scientific Reports',
		year: 2025,
		authors:
			'Yasin Atilkan, Berk Kırık, Eren Tuna Açıkbaş, Fatih Ekinci, Koray Açıcı, Tunç Aşuroğlu, Recep Benzer, Mehmet Serdar Güzel, Semra Benzer',
		summary:
			'Binary classification on tabular and image datasets with imbalanced class distributions. KANs achieved 95–100% accuracy on tabular features; a stacked-autoencoder architecture lifted KAN performance ~3.5% on image features. McNemar / Wilcoxon tests confirmed significant differences vs. SVM, MLPs, and naive Bayes.',
		link: 'https://www.nature.com/articles/s41598-025-34095-z',
	},
	{
		title:
			'Advancing Crayfish Disease Detection: A Comparative Study of Deep Learning and Canonical Machine Learning Techniques',
		venue: 'Peer-reviewed journal',
		year: 2024,
		authors:
			'Yasin Atilkan, Berk Kırık, Koray Açıcı, Recep Benzer, Fatih Ekinci, Mehmet Serdar Güzel',
		summary:
			'Hybrid RF-ResNet50 (ResNet50 features + Random Forest classifier) outperformed both pure deep-learning and pure canonical-ML models for disease detection on an imbalanced dataset. McNemar’s test confirmed significant performance gains over ConvNeXt-T + AdamW.',
	},
];

// ---- Certifications ----
const certifications = [
	{
		title: 'Concurrency in Go',
		issuer: 'University of California, Irvine — Coursera',
		date: 'Dec 2023',
		link: 'https://coursera.org/verify/UZD%20D%20P5EM58E3',
	},
	{ title: 'Python for Data Science', issuer: 'Verified Certificate', date: 'May 2022' },
	{ title: 'Introduction to Linux', issuer: 'Verified Certificate', date: 'May 2022' },
	{ title: 'AI For Everyone (I & II)', issuer: 'e-Government Certificate' },
];

// ---- Languages (with full proficiency breakdown from CV) ----
const languages = [
	{ name: 'Turkish', level: 'Native' },
	{
		name: 'English',
		level: 'Listening B2 · Reading C1 · Writing B2 · Speaking B2',
	},
	{
		name: 'German',
		level: 'Listening A1 · Reading A2 · Writing A2 · Speaking A1',
	},
];

// ---- Interests / Hobbies (from CV) ----
const interests = [
	'Open-source contributions',
	'Swimming',
	'Basketball',
	'Chess puzzles',
];

const visibleSocials = SOCIALS.filter((s) => s.label !== 'rss');
---

<Layout
	title="resume"
	description="Resume of Berk Kırık — Senior AI Engineer. Five-plus years in production ML across fintech and healthcare."
	subNavCategory="Resume"
	subNavCta={{ label: 'Download PDF', href: SITE.resumePath }}
>
	<!-- Hero (light) -->
	<section class="tile tile-light" style="padding-bottom: var(--space-xxl);">
		<div class="tile-content-narrow">
			<h1 class="t-display-lg" style="text-align: center;">Berk Kırık.</h1>
			<p class="t-lead-airy" style="text-align: center; margin-top: var(--space-md);">
				Senior AI Engineer with 5+ years building production ML in microservices —
				LLMs, RAG, agentic AI, and the Kubernetes infrastructure underneath.
				Background spans fintech and healthcare; trained originally as a
				Biomedical Engineer.
			</p>

			<p class="t-caption" style="text-align: center; margin-top: var(--space-lg); color: var(--ink-muted-48);">
				Ankara, Türkiye{' '}
				·{' '}
				{visibleSocials.map((s, i) => (
					<>
						{i > 0 && ' · '}
						<a
							href={s.href}
							target={s.external ? '_blank' : undefined}
							rel={s.external ? 'me noopener' : undefined}
						>{s.label}</a>
					</>
				))}
			</p>
		</div>
	</section>

	<!-- Experience (parchment) -->
	<section id="experience" class="tile tile-parchment">
		<div class="tile-content">
			<h2 class="t-display-md" style="text-align: center; margin-bottom: var(--space-xxl);">Experience</h2>

			<div class="cv-list">
				{experience.map((job) => (
					<article class="cv-entry">
						<p class="t-caption" style="color: var(--ink-muted-48); text-transform: uppercase; letter-spacing: 0.08em;">
							{job.period} · {job.location}
						</p>
						<h3 class="role">{job.role}</h3>
						<p class="where">
							{job.url ? (
								<a href={job.url} target="_blank" rel="noopener">{job.company}</a>
							) : job.company}
						</p>
						{job.summary && <p class="summary">{job.summary}</p>}

						<ul class="cv-bullets">
							{job.bullets.map((b) => (
								<li><strong>{b.heading}.</strong> {b.body}</li>
							))}
						</ul>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- Education (light) -->
	<section id="education" class="tile tile-light">
		<div class="tile-content">
			<h2 class="t-display-md" style="text-align: center; margin-bottom: var(--space-xxl);">Education</h2>

			<div class="cv-list">
				{education.map((e) => (
					<article class="cv-entry">
						<p class="t-caption" style="color: var(--ink-muted-48); text-transform: uppercase; letter-spacing: 0.08em;">
							{e.period} · {e.location}
						</p>
						<h3 class="role">{e.degree}</h3>
						<p class="where">
							{e.url ? (
								<a href={e.url} target="_blank" rel="noopener">{e.school}</a>
							) : e.school}
						</p>
						{e.note && <p class="summary">{e.note}</p>}
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- Skills (parchment) -->
	<section id="skills" class="tile tile-parchment">
		<div class="tile-content">
			<h2 class="t-display-md" style="text-align: center; margin-bottom: var(--space-xxl);">Skills</h2>

			<div class="skills-list">
				{Object.entries(skills).map(([group, items]) => (
					<div class="skills-row">
						<span class="group">{group}</span>
						<span class="items">{items.join(' · ')}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Publications (dark) -->
	<section id="publications" class="tile tile-dark">
		<div class="tile-content">
			<h2 class="t-display-md" style="text-align: center; margin-bottom: var(--space-xxl); color: var(--body-on-dark);">
				Publications
			</h2>

			<div class="cv-list">
				{publications.map((p) => (
					<article class="cv-entry">
						<p class="t-caption" style="color: var(--body-muted); text-transform: uppercase; letter-spacing: 0.08em;">
							{p.year} · {p.venue}
						</p>
						<h3 class="role" style="color: var(--body-on-dark);">
							{p.link ? (
								<a href={p.link} target="_blank" rel="noopener" style="color: var(--primary-on-dark);">{p.title}</a>
							) : p.title}
						</h3>
						<p class="where" style="color: var(--body-muted);">{p.authors}</p>
						<p class="summary" style="color: var(--body-on-dark);">{p.summary}</p>
					</article>
				))}
			</div>

			<p class="t-caption" style="color: var(--body-muted); text-align: center; margin-top: var(--space-xxl);">
				Full record on{' '}
				<a href="https://orcid.org/0009-0004-5045-3048" target="_blank" rel="noopener" style="color: var(--primary-on-dark);">ORCID</a>.
			</p>
		</div>
	</section>

	<!-- Certifications + Languages + Interests (parchment) -->
	<section class="tile tile-parchment">
		<div class="tile-content">
			<div style="display: grid; grid-template-columns: 1fr; gap: var(--space-section);">

				<!-- Certifications -->
				<div id="certifications">
					<h2 class="t-display-md" style="margin-bottom: var(--space-lg);">Certifications</h2>
					<ul class="skills-list">
						{certifications.map((c) => (
							<li class="skills-row">
								<span class="group">{c.date ?? ''}</span>
								<span class="items">
									{c.link ? (
										<a href={c.link} target="_blank" rel="noopener">{c.title}</a>
									) : (
										<strong>{c.title}</strong>
									)}
									{' — '}
									<span style="color: var(--ink-muted-80);">{c.issuer}</span>
								</span>
							</li>
						))}
					</ul>
				</div>

				<!-- Languages -->
				<div id="languages">
					<h2 class="t-display-md" style="margin-bottom: var(--space-lg);">Languages</h2>
					<ul class="skills-list">
						{languages.map((l) => (
							<li class="skills-row">
								<span class="group">{l.name}</span>
								<span class="items">{l.level}</span>
							</li>
						))}
					</ul>
				</div>

				<!-- Interests -->
				<div id="interests">
					<h2 class="t-display-md" style="margin-bottom: var(--space-lg);">Interests</h2>
					<p class="t-body" style="color: var(--ink-muted-80);">
						{interests.join(' · ')}
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Closing CTA (dark-2) -->
	<section class="tile tile-dark-2">
		<div class="tile-stack">
			<h2 class="t-display-lg" style="color: var(--body-on-dark);">Get in touch.</h2>
			<p class="t-lead-airy" style="color: var(--body-muted);">
				Best reached by email. PDF version of the full resume is one click away.
			</p>
			<div class="ctas">
				<a class="btn btn-primary" href="mailto:berk.kirik@outlook.com">Email me</a>
				<a class="btn btn-secondary-pill" href={SITE.resumePath} target="_blank" rel="noopener">Download PDF</a>
			</div>
		</div>
	</section>
</Layout>
