---
import '../styles/global.css';
import { SITE, NAV, SOCIALS } from '../config';

interface Props {
	title?: string;
	description?: string;
	/** Path to the OG image relative to /public. Defaults to the site-wide one. */
	ogImage?: string;
	/** When set, page is treated as an Article in structured data (use on blog posts). */
	article?: {
		publishedTime: string;
		modifiedTime?: string;
		tags?: string[];
	};
}

const { title, description = SITE.description, ogImage, article } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = currentPath === '/';

const ogImageUrl = new URL(ogImage ?? '/og/default.png', Astro.site).toString();

function isCurrent(href: string): boolean {
	const normalized = href.replace(/\/$/, '') || '/';
	if (normalized === '/') return currentPath === '/';
	return currentPath === normalized || currentPath.startsWith(normalized + '/');
}

const footerSocial = SOCIALS.filter((s) => s.label !== 'rss');

// JSON-LD structured data
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Berk Kırık',
	url: SITE.url,
	image: new URL('/og/default.png', Astro.site).toString(),
	jobTitle: 'Senior AI Engineer',
	worksFor: { '@type': 'Organization', name: 'Etiya', url: 'https://www.etiya.com/' },
	alumniOf: [
		{ '@type': 'CollegeOrUniversity', name: 'Ankara University' },
		{ '@type': 'CollegeOrUniversity', name: 'Istanbul University' },
	],
	address: { '@type': 'PostalAddress', addressLocality: 'Ankara', addressCountry: 'TR' },
	sameAs: [
		'https://github.com/Berkkirik',
		'https://www.linkedin.com/in/berkkirik/',
		'https://orcid.org/0009-0004-5045-3048',
	],
	knowsAbout: [
		'Machine learning',
		'Large language models',
		'Retrieval-augmented generation',
		'Agentic AI',
		'Kubernetes',
		'Biomedical engineering',
	],
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	url: SITE.url,
	name: SITE.title,
	description: SITE.description,
	author: { '@type': 'Person', name: 'Berk Kırık' },
	inLanguage: 'en',
};

const articleSchema = article
	? {
			'@context': 'https://schema.org',
			'@type': 'Article',
			headline: title,
			description,
			image: ogImageUrl,
			datePublished: article.publishedTime,
			...(article.modifiedTime ? { dateModified: article.modifiedTime } : {}),
			author: { '@type': 'Person', name: 'Berk Kırık', url: SITE.url },
			publisher: { '@type': 'Person', name: 'Berk Kırık', url: SITE.url },
			mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
			...(article.tags && article.tags.length > 0 ? { keywords: article.tags.join(', ') } : {}),
		}
	: null;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title={`${SITE.title} — Blog`} href="/rss.xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={SITE.author} />

		<meta property="og:type" content={article ? 'article' : 'website'} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={SITE.title} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="en_US" />
		{article && (
			<>
				<meta property="article:author" content="Berk Kırık" />
				<meta property="article:published_time" content={article.publishedTime} />
				{article.modifiedTime && (
					<meta property="article:modified_time" content={article.modifiedTime} />
				)}
				{article.tags?.map((t) => <meta property="article:tag" content={t} />)}
			</>
		)}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<meta name="theme-color" content="#f6f1e7" />

		{/* JSON-LD structured data */}
		<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
		{isHome && (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		)}
		{articleSchema && (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		)}
	</head>
	<body>
		<a class="sr-only" href="#main">Skip to content</a>

		<header class="masthead" role="banner">
			<div class="masthead-inner">
				<a class="masthead-brand" href="/" aria-label={`${SITE.author} — home`}>
					<span>{SITE.author}</span>
					<span class="masthead-version">/ v1</span>
				</a>

				<nav class="masthead-nav" aria-label="Primary">
					{NAV.filter((item) => item.href !== '/').map((item) => (
						<a
							href={item.href}
							aria-current={isCurrent(item.href) ? 'page' : undefined}
						>{item.label}</a>
					))}
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="colophon" role="contentinfo">
			<div class="colophon-inner">
				<p>
					<em>Berk Kırık</em> is a Senior AI Engineer based in Ankara, Türkiye.
					Reachable by <a href="mailto:berk.kirik@outlook.com">email</a> and on
					{' '}{footerSocial.filter((s) => s.label !== 'email').map((s, i, arr) => (
						<>
							<a
								href={s.href}
								target={s.external ? '_blank' : undefined}
								rel={s.external ? 'me noopener' : undefined}
							>{s.label}</a>{i < arr.length - 1 ? ', ' : ''}
						</>
					))}.
				</p>

				<div class="legal">
					<span>© {new Date().getFullYear()} Berk Kırık</span>
					<span>Set in Newsreader</span>
					<span>Built with Astro · GitHub Pages</span>
					<a href="/rss.xml" class="no-underline" style="font-style: normal;">rss</a>
				</div>
			</div>
		</footer>
	</body>
</html>
