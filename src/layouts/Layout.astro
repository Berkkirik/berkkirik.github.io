---
import '../styles/global.css';
import { SITE, NAV, SOCIALS } from '../config';

interface Props {
	title?: string;
	description?: string;
	/** Path to the OG image relative to /public. Defaults to the site-wide one. */
	ogImage?: string;
	/** When set, page is treated as an Article in structured data (use on blog posts). */
	article?: {
		publishedTime: string;
		modifiedTime?: string;
		tags?: string[];
	};
	/** When true, emits noindex and omits the canonical tag. Use on 404 and similar. */
	noindex?: boolean;
}

const { title, description = SITE.description, ogImage, article, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = currentPath === '/';

const ogImageUrl = new URL(ogImage ?? '/og/default.png', Astro.site).toString();

function isCurrent(href: string): boolean {
	const normalized = href.replace(/\/$/, '') || '/';
	if (normalized === '/') return currentPath === '/';
	return currentPath === normalized || currentPath.startsWith(normalized + '/');
}

const footerSocial = SOCIALS.filter((s) => s.label !== 'rss');

// JSON-LD structured data
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Berk Kırık',
	givenName: 'Berk',
	familyName: 'Kırık',
	jobTitle: 'Senior AI Engineer',
	description: SITE.description,
	url: SITE.url,
	image: new URL('/photo.jpg', Astro.site).toString(),
	email: 'mailto:berk.kirik@outlook.com',
	worksFor: { '@type': 'Organization', name: 'Etiya', url: 'https://www.etiya.com/' },
	alumniOf: [
		{ '@type': 'CollegeOrUniversity', name: 'Ankara University', url: 'https://www.ankara.edu.tr/' },
	],
	address: { '@type': 'PostalAddress', addressLocality: 'Ankara', addressCountry: 'TR' },
	knowsAbout: [
		'Large Language Models',
		'Retrieval-Augmented Generation',
		'Named Entity Recognition',
		'Agentic AI',
		'Kubernetes',
		'Machine Learning',
	],
	sameAs: [
		'https://www.linkedin.com/in/berkkirik/',
		'https://github.com/Berkkirik',
		'https://orcid.org/0009-0004-5045-3048',
	],
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	url: SITE.url,
	name: SITE.title,
	description: SITE.description,
	author: { '@type': 'Person', name: 'Berk Kırık' },
	inLanguage: 'en',
};

const articleSchema = article
	? {
			'@context': 'https://schema.org',
			'@type': 'Article',
			headline: title,
			description,
			image: ogImageUrl,
			datePublished: article.publishedTime,
			...(article.modifiedTime ? { dateModified: article.modifiedTime } : {}),
			author: { '@type': 'Person', name: 'Berk Kırık', url: SITE.url },
			publisher: { '@type': 'Person', name: 'Berk Kırık', url: SITE.url },
			mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
			...(article.tags && article.tags.length > 0 ? { keywords: article.tags.join(', ') } : {}),
		}
	: null;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{!noindex && <link rel="canonical" href={canonical} />}
		{noindex && <meta name="robots" content="noindex, follow" />}
		<link rel="alternate" type="application/rss+xml" title={`${SITE.title} — Blog`} href="/rss.xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={SITE.author} />

		<meta property="og:type" content={article ? 'article' : 'website'} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={SITE.title} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="en_US" />
		{article && (
			<>
				<meta property="article:author" content="Berk Kırık" />
				<meta property="article:published_time" content={article.publishedTime} />
				{article.modifiedTime && (
					<meta property="article:modified_time" content={article.modifiedTime} />
				)}
				{article.tags?.map((t) => <meta property="article:tag" content={t} />)}
			</>
		)}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f1e7" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1a1714" />

		{/* Pre-paint theme init — reads saved preference and sets data-theme
		    on <html> BEFORE first paint to avoid a flash of wrong theme. */}
		<script is:inline>
			(function () {
				try {
					var saved = localStorage.getItem('theme');
					if (saved === 'light' || saved === 'dark') {
						document.documentElement.setAttribute('data-theme', saved);
					}
				} catch (e) {}
			})();
		</script>

		{/* JSON-LD structured data */}
		<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
		{isHome && (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		)}
		{articleSchema && (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		)}
	</head>
	<body>
		<a class="sr-only" href="#main">Skip to content</a>

		<header class="masthead" role="banner">
			<div class="masthead-inner">
				<a class="masthead-brand" href="/" aria-label={`${SITE.author} — home`}>
					<span>{SITE.author}</span>
					<span class="masthead-version">/ v1</span>
				</a>

				<nav class="masthead-nav" aria-label="Primary">
					{NAV.filter((item) => item.href !== '/').map((item) => (
						<a
							href={item.href}
							aria-current={isCurrent(item.href) ? 'page' : undefined}
						>{item.label}</a>
					))}
					<button
						class="theme-toggle"
						type="button"
						data-theme-toggle
						aria-label="Toggle dark mode"
						title="Toggle dark mode"
					>
						<span class="theme-toggle-icon theme-toggle-icon-light" aria-hidden="true">☾</span>
						<span class="theme-toggle-icon theme-toggle-icon-dark" aria-hidden="true">☀</span>
					</button>
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="colophon" role="contentinfo">
			<div class="colophon-inner">
				<p>
					<em>Berk Kırık</em> is a Senior AI Engineer based in Ankara, Türkiye.
					Reachable by <a href="mailto:berk.kirik@outlook.com">email</a> and on
					{' '}{footerSocial.filter((s) => s.label !== 'email').map((s, i, arr) => (
						<>
							<a
								href={s.href}
								target={s.external ? '_blank' : undefined}
								rel={s.external ? 'me noopener' : undefined}
							>{s.label}</a>{i < arr.length - 1 ? ', ' : ''}
						</>
					))}.
				</p>

				<div class="legal">
					<span>© {new Date().getFullYear()} Berk Kırık</span>
					<span>Set in Newsreader</span>
					<span>Built with Astro · GitHub Pages</span>
					<a href="/rss.xml" class="no-underline" style="font-style: normal;">rss</a>
				</div>
			</div>
		</footer>

		{/* Theme-toggle handler — picks the opposite of whatever is currently
		    showing, persists to localStorage, and keeps the aria-label honest. */}
		<script is:inline>
			(function () {
				var btn = document.querySelector('[data-theme-toggle]');
				if (!btn) return;
				function current() {
					var attr = document.documentElement.getAttribute('data-theme');
					if (attr === 'light' || attr === 'dark') return attr;
					return window.matchMedia('(prefers-color-scheme: dark)').matches
						? 'dark'
						: 'light';
				}
				function apply(next) {
					document.documentElement.setAttribute('data-theme', next);
					try {
						localStorage.setItem('theme', next);
					} catch (e) {}
					btn.setAttribute(
						'aria-label',
						next === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'
					);
				}
				apply(current());
				btn.addEventListener('click', function () {
					apply(current() === 'dark' ? 'light' : 'dark');
				});
			})();
		</script>
	</body>
</html>
