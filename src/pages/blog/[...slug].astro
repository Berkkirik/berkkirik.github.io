---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog', (p) =>
		import.meta.env.PROD ? !p.data.draft : true,
	);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout
	title={post.data.title}
	description={post.data.description}
	subNavCategory="Blog"
	subNavCta={{ label: 'All posts', href: '/blog/' }}
>
	<!-- Article header tile (light) -->
	<section class="tile tile-light" style="padding-bottom: var(--space-xxl);">
		<div class="tile-content-narrow center">
			<p class="t-caption" style="color: var(--ink-muted-48); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--space-md);">
				<time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
				{post.data.updatedDate && (
					<span> · updated {fmt(post.data.updatedDate)}</span>
				)}
				{post.data.tags.length > 0 && (
					<span> · {post.data.tags.map((t) => `#${t}`).join(' ')}</span>
				)}
				{post.data.draft && <span> · DRAFT</span>}
			</p>
			<h1 class="t-display-lg">{post.data.title}</h1>
			{post.data.description && (
				<p class="t-lead-airy" style="margin-top: var(--space-md);">
					{post.data.description}
				</p>
			)}
		</div>
	</section>

	<!-- Article body tile (light) -->
	<article class="tile tile-light" style="padding-top: 0;">
		<div class="prose">
			<Content />
		</div>
	</article>

	<!-- Closing tile (parchment) -->
	<section class="tile tile-parchment" style="padding-top: var(--space-xxl); padding-bottom: var(--space-xxl);">
		<div class="tile-stack">
			<a class="btn btn-secondary-pill" href="/blog/">← All posts</a>
		</div>
	</section>
</Layout>
